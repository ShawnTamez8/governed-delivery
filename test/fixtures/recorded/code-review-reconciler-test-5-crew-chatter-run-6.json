      "findings": [
        {
          "findingId": 208,
          "location": "frontend/src/lib/useAutosave.ts",
          "intentKey": "autosave-latest-draft-deferred-behind-inflight-save",
          "reports": [
            {
              "reviewer": "code-reviewer-correctness",
              "severity": "high",
              "subject": "When a save request is still in flight, flush() returns the running drain loop instead of sending the newer draft, so an edit made 750 ms after the last keystroke waits for the slow earlier response and can be sent more than 1,000 ms after the last keystroke, violating AC-015 and the plan's rule that a send is never deferred behind an earlier request."
            }
          ]
        },
        {
          "findingId": 209,
          "location": "backend/src/features/auth/service.ts:24",
          "intentKey": "email-nul-byte-validation-bypass",
          "reports": [
            {
              "reviewer": "code-reviewer-security",
              "severity": "high",
              "subject": "validateEmail's regex lets U+0000 through, so a request such as POST /api/auth/register with an email containing a NUL byte reaches Postgres, which rejects the text parameter, and the client gets a generic HTTP 500 instead of a 400 naming the email field, failing AC-075."
            }
          ]
        },
        {
          "findingId": 210,
          "location": "frontend/src/lib/useAutosave.ts:181",
          "intentKey": "autosave-latest-edit-deferred-behind-inflight-save",
          "reports": [
            {
              "reviewer": "code-reviewer-state-integrity",
              "severity": "high",
              "subject": "When a save request is still in flight, flush() returns the running drain instead of sending the newer draft, so the latest edit is held until the earlier request settles (up to the 15 s api timeout), which violates AC-015's requirement to send the latest content within 1,000 ms of the last keystroke."
            }
          ]
        },
        {
          "findingId": 211,
          "location": "frontend/src/lib/useAutosave.ts:141",
          "intentKey": "unauthorized-save-drops-unsaved-edit",
          "reports": [
            {
              "reviewer": "code-reviewer-state-integrity",
              "severity": "high",
              "subject": "When a PATCH returns 401 (for example after a password reset invalidates the session), the hook only sets an error status and never routes the user back to sign-in, so switching notes discards the unsent edit while the user is still shown an editor."
            }
          ]
        },
        {
          "findingId": 212,
          "location": "frontend/src/lib/useAutosave.ts:147",
          "intentKey": "queued-draft-never-retried-after-server-error",
          "reports": [
            {
              "reviewer": "code-reviewer-state-integrity",
              "severity": "medium",
              "subject": "A non-offline save failure (for example a 500) during unmount is queued, but the queue is only retried on a browser 'online' event that never fires while the browser stays online, so the draft stays unsent and is lost on reload."
            }
          ]
        },
        {
          "findingId": 213,
          "location": "backend/src/features/auth/service.ts",
          "intentKey": "rollback-error-masks-original-failure",
          "reports": [
            {
              "reviewer": "code-reviewer-state-integrity",
              "severity": "low",
              "subject": "If ROLLBACK itself throws in resetPassword (for example after a dropped connection), the rollback error replaces the original error and the client is released to the pool without an error argument, so a broken connection can be reused by later requests."
            }
          ]
        },
        {
          "findingId": 214,
          "location": "backend/src/db/migrate.ts",
          "intentKey": "rollback-error-masks-migration-failure",
          "reports": [
            {
              "reviewer": "code-reviewer-state-integrity",
              "severity": "low",
              "subject": "If ROLLBACK throws after a failed migration statement, the rollback error replaces the original migration error and the client is released without an error argument, so startup diagnostics lose the real cause and a broken client can return to the pool."
            }
          ]
        }
      ]
    },
