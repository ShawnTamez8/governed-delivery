      "findings": [
        {
          "findingId": 901,
          "location": "backend/src/features/auth/service.ts",
          "intentKey": "unvalidated-nul-in-email-address",
          "reports": [
            {
              "reviewer": "code-reviewer-security",
              "severity": "high",
              "subject": "validateEmail accepts a NUL character or lone surrogate inside the address (the regex only excludes whitespace and @), so register or sign-in sends it to PostgreSQL, which rejects the query, and the client receives HTTP 500 instead of the HTTP 400 field error that AC-075 requires."
            }
          ],
          "from": "control-4#1"
        },
        {
          "findingId": 902,
          "location": "backend/src/features/auth/service.ts:19",
          "intentKey": "email-validation-allows-control-characters",
          "reports": [
            {
              "reviewer": "code-reviewer-security",
              "severity": "low",
              "subject": "validateEmail's regex only excludes whitespace, so an email containing ASCII control characters such as ESC (\\u001b) is accepted and is then written verbatim to the server log by requestPasswordReset, allowing terminal escape sequences to be injected into log output."
            }
          ],
          "from": "control-3#2"
        },
        {
          "findingId": 903,
          "location": "backend/src/features/notes/routes.ts",
          "intentKey": "unvalidated-link-href-scheme-stored",
          "reports": [
            {
              "reviewer": "code-reviewer-security",
              "severity": "low",
              "subject": "PATCH /api/notes/:id accepts any link mark href, including javascript: URLs, because only the doc shape is checked, so a crafted body is stored and later loaded unfiltered into the editor, bypassing the protocol allow-list that only the toolbar enforces."
            }
          ],
          "from": "control-8#1"
        },
        {
          "findingId": 904,
          "location": "backend/src/features/auth/service.ts:94",
          "intentKey": "unvalidated-email-reaches-db-query",
          "reports": [
            {
              "reviewer": "code-reviewer-security",
              "severity": "low",
              "subject": "authenticate() does not validate the email, so a sign-in email containing U+0000 reaches the Postgres text query, raises a database error, and returns a generic HTTP 500 instead of the documented 401 or 400 response."
            }
          ],
          "from": "control-6#2"
        },
        {
          "findingId": 905,
          "location": "backend/src/lib/auth.ts",
          "intentKey": "session-token-not-revoked-on-reset-or-signout",
          "reports": [
            {
              "reviewer": "code-reviewer-security",
              "severity": "medium",
              "subject": "Session JWTs have no server-side revocation or password-version check, so a session copied before sign-out or before a password reset stays valid for up to 7 days and keeps access to the account after the owner resets the password."
            }
          ],
          "from": "control-10#2"
        },
        {
          "findingId": 906,
          "location": "frontend/src/lib/useAutosave.ts",
          "intentKey": "queued-draft-survives-session-expiry",
          "reports": [
            {
              "reviewer": "code-reviewer-security",
              "severity": "low",
              "subject": "The module-level offline draft queue and store selectedNoteId are not cleared on a 401 session expiry, so a draft for the previous account's note is sent under the next account's cookie, rejected with 404, and never saved while the beforeunload prompt stays active."
            }
          ],
          "from": "b-2#1"
        }
      ]
    }
